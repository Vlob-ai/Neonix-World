{
  "status": "Proposal · map planning assumptions · 2026-10-13 · not established canon",
  "assumptions": {
    "scope": "All figures, neighborhood labels and business names are editable planning proposals. Existing hub IDs and borough assignments come from lore.json; no owners, histories, factions or new lore claims are introduced.",
    "representation": "The 85 named sites are representative anchors, not an exhaustive business inventory. Eight major hubs have six examples, seven medium hubs have four, and three bars have three.",
    "catchment": "Each estimate covers the hub and its immediately supporting neighborhood, not the entire borough. Catchments can overlap; do not sum them as unique city population or citywide business totals.",
    "footfall": "Rough busy-operating scenarios, not measured attendance or simultaneous occupancy. A visit is a use of the hub during the stated day or event; repeat visitors can appear across hubs. Foundry and Underforge counts describe one staffed shift. The theatre event is one show.",
    "foodModel": {
      "formula": "Low = ceil(low footfall × purchased-food share ÷ high counter throughput); high = ceil(high footfall × share ÷ low counter throughput).",
      "normalThroughput": {
        "low": 150,
        "high": 250,
        "unit": "meals per counter per stated day, shift or theatre event"
      },
      "stadiumThroughput": {
        "low": 200,
        "high": 350,
        "unit": "servings per counter per stadium event"
      },
      "share": "Each hub records its assumed food-purchase share. These are scenario inputs rather than survey findings.",
      "scope": "Food counters include on-site concessions, canteens, market stalls, takeaways and nearby restaurant serving capacity. A large venue may contain many counters; the estimate is not a count of separate restaurants or named map sites.",
      "limitation": "A first sizing pass only; demand peaks, queues, opening hours, repeat purchases and delivery logistics need later design."
    },
    "supportModel": "Non-food support ranges are rough judgment calls for nearby shops, repair/service businesses and commercial transport operators. They are not calculated from a fixed ratio and exclude the main hub's core operation, general market stall inventory and public transit stops.",
    "mapPlacement": "dx/dy are small local SVG display offsets from the parent hub, not final geography, metres, district boundaries or walking distances. Every representative site inherits its hub's borough and depth; Underforge and Breathless Bazaar sites remain underground.",
    "naming": {
      "rule": "Combine a recognizable hub cue with one borough stem and one functional suffix, for example 'Ironheart Rivet Canteen'. Local street-position words may replace the stem where clearer. Pools and every resulting name are editable.",
      "neighborhoodRule": "Use the hub cue plus a physical grouping: Terrace, Court, Crossings, Gate Ring, Shift Belt, Loops, Galleries or Rows. Labels describe the proposed catchment, not a new administrative borough.",
